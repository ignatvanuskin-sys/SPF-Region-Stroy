# ============================================================================
# СПФ Регион Строй — переменные окружения
#
# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает (.gitignore).
#
# Минимум для запуска локально: ничего. Сайт заработает с локальным хранилищем.
# Минимум для продакшна: SITE_URL, SESSION_SECRET, DATABASE_URL, TELEGRAM_*.
# ============================================================================

# --- Основное -----------------------------------------------------------------

# Публичный адрес сайта. Используется в canonical, sitemap.xml, OG-разметке и в
# ссылках с QR-кодов. Без него QR-коды будут вести на localhost.
SITE_URL=http://localhost:3000

# Часовой пояс для показа времени (Астана — UTC+5 круглый год).
DEFAULT_TIMEZONE=Asia/Almaty

# --- Безопасность -------------------------------------------------------------

# Обязательно в продакшне. Секрет для подписи сессионных cookie админки.
# Минимум 16 символов. Если сменить — все входы в админку разом перестанут
# действовать (удобно, если потерялось устройство с открытой сессией).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Обязательно. Секрет для служебных эндпоинтов /api/cron/*.
# Vercel при вызове cron сам отправляет его в заголовке Authorization: Bearer.
CRON_SECRET=

# Создание владельца админки: npm run admin:create
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Хранилище данных ---------------------------------------------------------

# Вариант 1 (продакшн): PostgreSQL.
# Драйвер включится автоматически, как только задан DATABASE_URL.
# Схема применяется командой npm run db:migrate.
DATABASE_URL=

# Вариант 2 (локально): файл ./data/store.json. Ничего задавать не нужно.
# Можно переопределить путь:
# DATA_DIR=./data

# Явный выбор драйвера: pg | json. Обычно не требуется — определяется по DATABASE_URL.
# DB_DRIVER=pg
# PG_POOL_MAX=8

# --- Уведомления --------------------------------------------------------------

# Telegram. Без этих переменных заявка сохраняется и видна в админке,
# но менеджер не получит уведомление (в админке будет красная пометка).
# 1. Создайте бота у @BotFather → TELEGRAM_BOT_TOKEN
# 2. Добавьте бота в служебный чат, узнайте chat id → TELEGRAM_LEADS_CHAT_ID
# 3. TELEGRAM_OWNER_ID: личный chat id владельца (для эскалаций по SLA)
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEADS_CHAT_ID=
TELEGRAM_OWNER_ID=

# Секрет для webhook. Telegram присылает его в заголовке
# X-Telegram-Bot-Api-Secret-Token — без него webhook отвечает 503.
TELEGRAM_WEBHOOK_SECRET=

# Запасной канал (e-mail) — подключается, если Telegram недоступен.
# Resend по HTTP, без SDK.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=СПФ Регион Строй <onboarding@resend.dev>
NOTIFY_EMAIL_TO=

# Универсальный webhook для будущей CRM (Bitrix24, amoCRM, Google Sheets).
LEAD_WEBHOOK_URL=

# --- Антиспам -----------------------------------------------------------------

# Cloudflare Turnstile — опционально. Без ключей работает honeypot + лимиты.
TURNSTILE_SECRET_KEY=

# --- Контакты (можно задать и в админке — админка важнее) ----------------------

PHONE_PRIMARY=+77018936787
WHATSAPP_PRIMARY=77018936787
WHATSAPP_SECONDARY=77011776090
CONTACT_EMAIL=plastmontag_2010@mail.ru
INSTAGRAM_URL=https://instagram.com/spf01002
GIS_FIRM_URL=https://2gis.kz/astana/firm/70000001042561575
GIS_REVIEWS_URL=https://2gis.kz/astana/firm/70000001042561575/tab/reviews

# --- Аналитика (подключается только после согласия посетителя) ---------------

YM_COUNTER_ID=
GA4_ID=
META_PIXEL_ID=

# Значение дублируется в NEXT_PUBLIC_*, потому что используется на клиенте.
NEXT_PUBLIC_YM_COUNTER_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Режимы -------------------------------------------------------------------

# off (по умолчанию) — цены не показываются нигде.
# range — показывать диапазон «от–до» с пометкой «после замера».
# Заработает после заполнения коэффициентов (таблица settings, ключ price_rules).
PRICE_DISPLAY=off

# Контроль скорости первого ответа, минуты.
SLA_FIRST_RESPONSE_MINUTES=10

# Сколько дней ждать после монтажа, прежде чем просить отзыв.
REVIEW_REQUEST_DELAY_DAYS=2

# Фиче-флаги фазы 2 и 3.
KK_ENABLED=false
AI_ASSISTANT_ENABLED=false
ORDER_STATUS_PAGE_ENABLED=false

# --- Файловое хранилище -------------------------------------------------------

# Локальный драйвер (по умолчанию) работает только на одном инстансе и не
# подходит для serverless: файлы не переживут перезапуск.
# Для продакшна подключите S3-совместимое хранилище:
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# или Vercel Blob:
# BLOB_READ_WRITE_TOKEN=
