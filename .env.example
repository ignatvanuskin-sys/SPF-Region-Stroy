# ─────────────────────────────────────────────────────────────
# СПФ Регион Строй — переменные окружения
# Скопируйте в .env.local и заполните. Секреты НЕ коммитить.
# ─────────────────────────────────────────────────────────────

# Режим сборки: concept (демо, по умолчанию) | production (боевой)
SITE_MODE=concept

# Базовый адрес сайта (canonical, sitemap, Open Graph)
SITE_URL=https://example.kz

# Куда уходят заявки: test (тестовый чат разработчика) | prod (чат компании)
LEAD_TARGET=test

# Telegram — основной получатель заявок.
# Если ни один получатель не задан, POST /api/lead вернёт 503 и сайт покажет
# честную плашку «Форма сейчас не подключена».
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_TEST=
TELEGRAM_CHAT_ID_PROD=

# Дублирование заявок на email (необязательно).
# Вариант А — Resend (только ключ):
RESEND_API_KEY=
# Вариант Б — SMTP (нужны все четыре):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEAD_EMAIL_TO=

# Будущая интеграция CRM (Bitrix24 / amoCRM / Kommo). По умолчанию не используется.
CRM_WEBHOOK_URL=

# Аналитика. Пока переменные пустые, скрипты не загружаются вообще.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YM_ID=

# Флаги
# Казахская версия включается только после проверки носителем.
KK_ENABLED=false
# Портфолио: в production блок виден только при >= 3 реальных кейсах с фото.
PORTFOLIO_ENABLED=false
