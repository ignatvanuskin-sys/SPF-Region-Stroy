# ─────────────────────────────────────────────────────────────
# СПФ Регион Строй — переменные окружения
# Скопируйте в .env.local и заполните. Секреты НЕ коммитить.
# ─────────────────────────────────────────────────────────────

# ── Режим и адрес ────────────────────────────────────────────
# concept (демо, по умолчанию) | production (боевой)
SITE_MODE=concept
SITE_URL=https://example.kz

# ── Приём заявок ─────────────────────────────────────────────
# Куда уходят заявки: test (тестовый чат разработчика) | prod (чат компании)
LEAD_TARGET=test

# Telegram — основной канал для менеджера (заявки и напоминания).
# Если канал не настроен, POST /api/lead отвечает 503 и сайт честно сообщает,
# что форма не подключена.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_TEST=
TELEGRAM_CHAT_ID_PROD=

# ── CRM ──────────────────────────────────────────────────────
# Выбирается автоматически по заполненным переменным.
# Приоритет: Bitrix24 → amoCRM → универсальный webhook.

# Bitrix24: входящий вебхук с правами crm и tasks
BITRIX24_WEBHOOK_URL=
BITRIX24_ASSIGNED_BY_ID=

# amoCRM: поддомен аккаунта и долгосрочный токен
AMOCRM_SUBDOMAIN=
AMOCRM_ACCESS_TOKEN=
AMOCRM_PIPELINE_ID=

# Универсальный webhook для другой системы
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# ── Хранилище для напоминаний ────────────────────────────────
# Без Redis планировщик видит только заявки текущего инстанса.
# Продовая работа автоматизации требует Upstash Redis (REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Планировщик ──────────────────────────────────────────────
# Vercel передаёт этот секрет в заголовке Authorization для cron-запросов.
CRON_SECRET=

# ── Подтверждение клиенту на email (необязательно) ───────────
# Вариант А — Resend (только ключ):
RESEND_API_KEY=
# Вариант Б — SMTP (нужны все четыре):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEAD_EMAIL_TO=

# ── Аналитика ────────────────────────────────────────────────
# Пока переменные пустые, скрипты не загружаются вообще.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YM_ID=

# ── Флаги ────────────────────────────────────────────────────
# Казахская версия включается только после проверки носителем.
KK_ENABLED=false
# Портфолио: в production блок виден только при >= 3 реальных кейсах с фото.
PORTFOLIO_ENABLED=false
